
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CodeMarket - Developer Marketplace</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #080e1b;
  color: white;
}

header {
  background: #101a2d;
  padding: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  border-bottom: 1px solid #263650;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #38bdf8;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 7px;
}

.hero {
  text-align: center;
  padding: 75px 18px;
  background: linear-gradient(135deg,#101f3b,#152d55);
}

.hero h1 {
  font-size: 38px;
  margin-bottom: 15px;
}

.hero span {
  color: #38bdf8;
}

.hero p {
  color: #c4d3e8;
  margin-bottom: 25px;
  line-height: 1.6;
}

button {
  border: none;
  padding: 12px 20px;
  border-radius: 8px;
  background: #0284c7;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #0369a1;
}

.section {
  padding: 45px 18px;
  max-width: 1100px;
  margin: auto;
}

.section h2 {
  text-align: center;
  margin-bottom: 25px;
}

.search {
  display: block;
  width: 100%;
  max-width: 500px;
  margin: 0 auto 25px;
  padding: 14px;
  border-radius: 8px;
  border: 1px solid #334155;
  background: #111d30;
  color: white;
  font-size: 16px;
}

.categories {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 25px;
}

.categories button {
  background: #1e293b;
  border: 1px solid #334155;
}

.categories button.active {
  background: #0284c7;
}

.projects {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 18px;
}

.card {
  background: #111d30;
  border: 1px solid #263650;
  border-radius: 12px;
  padding: 20px;
}

.card .emoji {
  font-size: 35px;
}

.card h3 {
  margin: 13px 0;
}

.card p {
  color: #aabbd1;
  line-height: 1.5;
  margin-bottom: 15px;
}

.price {
  color: #38bdf8;
  font-weight: bold;
  margin-bottom: 15px;
}

.card button {
  width: 100%;
}

.about {
  text-align: center;
  background: #101a2d;
  padding: 45px 20px;
  line-height: 1.8;
}

.contact {
  text-align: center;
  padding: 45px 20px;
}

.contact p {
  color: #aabbd1;
  margin: 15px;
}

footer {
  text-align: center;
  background: #050a13;
  color: #9caec5;
  padding: 22px;
}

@media(max-width:500px) {
  .hero h1 {
    font-size: 29px;
  }
  nav {
    width: 100%;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">⚡ CodeMarket</div>

  <nav>
    <a href="#home">Home</a>
    <a href="#projects">Projects</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section class="hero" id="home">
  <h1>Discover Amazing <span>Code</span></h1>
  <p>
    Explore creative projects, discover new ideas
    and showcase your development skills.
  </p>
  <button onclick="document.getElementById('projects').scrollIntoView()">
    Explore Projects
  </button>
</section>

<section class="section" id="projects">
  <h2>🚀 Explore Projects</h2>

  <input
    class="search"
    id="search"
    placeholder="Search projects..."
    oninput="showProjects()"
  >

  <div class="categories">
    <button class="active" onclick="filterProjects('All',this)">All</button>
    <button onclick="filterProjects('Website',this)">Websites</button>
    <button onclick="filterProjects('Python',this)">Python</button>
    <button onclick="filterProjects('Game',this)">Games</button>
    <button onclick="filterProjects('App',this)">Apps</button>
  </div>

  <div class="projects" id="projectList"></div>
</section>

<section class="about" id="about">
  <h2>About CodeMarket</h2>
  <p>
    CodeMarket is a student-built project marketplace demo.
    It is designed to help developers showcase their creativity
    and coding projects.
  </p>
</section>

<section class="contact" id="contact">
  <h2>📩 Contact</h2>
  <p>Interested in a project? Contact the website owner.</p>
  <button onclick="alert('Add your parent-approved contact method here!')">
    Contact Us
  </button>
</section>

<footer>
  © 2026 CodeMarket | Built with creativity 💙
</footer>

<script>

const projects = [
  {
    name: "Smart Calculator",
    type: "Website",
    emoji: "🧮",
    description: "A simple and useful calculator.",
    price: "Demo: ₹50"
  },
  {
    name: "Python Quiz",
    type: "Python",
    emoji: "🐍",
    description: "Test your knowledge with a quiz.",
    price: "Demo: ₹80"
  },
  {
    name: "Space Adventure",
    type: "Game",
    emoji: "🎮",
    description: "A fun beginner game concept.",
    price: "Demo: ₹100"
  },
  {
    name: "Student Planner",
    type: "App",
    emoji: "📱",
    description: "Organize your daily study tasks.",
    price: "Demo: ₹100"
  },
  {
    name: "Portfolio Website",
    type: "Website",
    emoji: "🌐",
    description: "Showcase your work online.",
    price: "Demo: ₹150"
  },
  {
    name: "Number Guessing",
    type: "Python",
    emoji: "🔢",
    description: "A fun number guessing program.",
    price: "Demo: ₹50"
  }
];

let currentFilter = "All";

function showProjects() {
  const list = document.getElementById("projectList");
  const search = document.getElementById("search").value.toLowerCase();

  list.innerHTML = "";

  const filtered = projects.filter(project => {
    const matchesCategory =
      currentFilter === "All" || project.type === currentFilter;

    const matchesSearch =
      project.name.toLowerCase().includes(search) ||
      project.description.toLowerCase().includes(search);

    return matchesCategory && matchesSearch;
  });

  if (filtered.length === 0) {
    list.innerHTML = "<p>No projects found.</p>";
    return;
  }

  filtered.forEach(project => {
    const card = document.createElement("div");
    card.className = "card";

    const emoji = document.createElement("div");
    emoji.className = "emoji";
    emoji.textContent = project.emoji;

    const title = document.createElement("h3");
    title.textContent = project.name;

    const description = document.createElement("p");
    description.textContent = project.description;

    const price = document.createElement("div");
    price.className = "price";
    price.textContent = project.price;

    const button = document.createElement("button");
    button.textContent = "View Details";
    button.onclick = () => alert(
      project.name + "\n" +
      project.description +
      "\nCategory: " + project.type +
      "\n" + project.price +
      "\nDemo listing only."
    );

    card.append(emoji, title, description, price, button);
    list.appendChild(card);
  });
}

function filterProjects(type, button) {
  currentFilter = type;

  document.querySelectorAll(".categories button")
    .forEach(b => b.classList.remove("active"));

  button.classList.add("active");
  showProjects();
}

showProjects();

</script>
</body>
</html>
